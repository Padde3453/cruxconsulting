          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Search terms, e.g. 'tender automation'."
            },
            "language": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "en",
                    "de"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Language of the returned content. Defaults to English."
